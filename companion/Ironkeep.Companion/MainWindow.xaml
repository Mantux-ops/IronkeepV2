<Window x:Class="Ironkeep.Companion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ironkeep Companion"
        Icon="/Assets/logo.png"
        Width="460" Height="800"
        MinWidth="420" MinHeight="640"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
  <Border Background="{StaticResource BgBrush}" Padding="16,14">
  <DockPanel>
    <Grid DockPanel.Dock="Top">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Rectangle Width="32" Height="32" RadiusX="8" RadiusY="8" VerticalAlignment="Center">
        <Rectangle.Fill>
          <ImageBrush ImageSource="/Assets/logo.png" Stretch="UniformToFill"/>
        </Rectangle.Fill>
      </Rectangle>
      <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
        <TextBlock Text="Ironkeep" Style="{StaticResource BrandName}"/>
        <TextBlock Text="{Binding Version, StringFormat=Companion {0}}" Style="{StaticResource MutedText}"/>
      </StackPanel>
    </Grid>

    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <Button Content="Sync now" Style="{StaticResource AccentButton}" HorizontalAlignment="Stretch" Click="SyncClick" AutomationProperties.Name="Sync now"/>
      <UniformGrid Columns="3" Margin="0,8,0,0">
        <Button Content="Website" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="WebClick" AutomationProperties.Name="Open website"/>
        <Button Content="Settings" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="SettingsClick" AutomationProperties.Name="Settings"/>
        <Button Content="History" Style="{StaticResource GhostButton}" Click="HistoryClick" AutomationProperties.Name="View synchronization history"/>
      </UniformGrid>
    </StackPanel>

    <ScrollViewer Style="{StaticResource IronkeepScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Text="Discord" Style="{StaticResource CardTitle}"/>
            <TextBlock Text="{Binding CardDetail}" Style="{StaticResource CardDesc}"/>
            <ComboBox x:Name="GuildBox" Margin="0,10,0,0" MinHeight="36" SelectionChanged="GuildChanged" AutomationProperties.Name="Guild"/>
            <Button x:Name="ConnectButton" Content="Connect with Discord" Style="{StaticResource AccentButton}" HorizontalAlignment="Stretch" Margin="0,12,0,0" Click="ConnectClick" AutomationProperties.Name="Connect with Discord"/>
            <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch" Margin="0,8,0,0" Click="CancelClick" AutomationProperties.Name="Cancel connection"/>
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Button x:Name="DisconnectButton" Grid.Column="0" Content="Disconnect" Style="{StaticResource GhostButton}" Click="DisconnectClick" AutomationProperties.Name="Disconnect"/>
              <Button x:Name="RetryButton" Grid.Column="2" Content="Retry" Style="{StaticResource GhostButton}" Click="RetryClick" AutomationProperties.Name="Retry connection"/>
            </Grid>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource StatusBanner}" Margin="0,8,0,10">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Ellipse Style="{StaticResource StatusDot}"/>
              <TextBlock Text="{Binding Headline}" Style="{StaticResource CardTitle}"/>
            </StackPanel>
            <TextBlock Margin="16,4,0,0" Style="{StaticResource MutedText}" Foreground="{StaticResource Text2Brush}" Text="{Binding Detail}"/>
          </StackPanel>
        </Border>

        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource StatCard}">
            <StackPanel>
              <TextBlock Text="Pending" Style="{StaticResource MutedText}"/>
              <TextBlock Text="{Binding Pending}" FontSize="20" FontWeight="Bold" Margin="0,2,0,0">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource OrangeBrush}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Pending}" Value="0">
                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource StatCard}">
            <StackPanel>
              <TextBlock Text="Retry" Style="{StaticResource MutedText}"/>
              <TextBlock Text="{Binding Retry}" FontSize="20" FontWeight="Bold" Margin="0,2,0,0">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource OrangeBrush}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Retry}" Value="0">
                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </Border>
          <Border Grid.Column="4" Style="{StaticResource StatCard}">
            <StackPanel>
              <TextBlock Text="Failed" Style="{StaticResource MutedText}"/>
              <TextBlock Text="{Binding Failed}" FontSize="20" FontWeight="Bold" Margin="0,2,0,0">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource RedBrush}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Failed}" Value="0">
                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </Border>
        </Grid>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="WoW Forever" Style="{StaticResource CardTitle}"/>
            <TextBlock Text="{Binding FolderStatus}" Style="{StaticResource CardDesc}"/>
            <TextBlock Text="{Binding SavedStatus}" Style="{StaticResource FieldHint}"/>
            <TextBlock Text="{Binding RosterStatus}" Style="{StaticResource FieldHint}"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0">
          <StackPanel>
            <TextBlock Text="Last successful upload" Style="{StaticResource CardTitle}"/>
            <TextBlock Text="{Binding LastUpload}" Style="{StaticResource CardDesc}"/>
            <TextBlock Text="{Binding Guild, StringFormat=Guild {0}}" Style="{StaticResource FieldHint}"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
  </Border>
</Window>
