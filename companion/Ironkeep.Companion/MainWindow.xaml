<Window x:Class="Ironkeep.Companion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ironkeep Companion"
        Width="460" Height="620"
        MinWidth="420" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <DockPanel>
        <TextBlock Text="Ironkeep Companion" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Text="{Binding Version, StringFormat=v{0}}"/>
      </DockPanel>
      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
        <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
          <Ellipse.Style>
            <Style TargetType="Ellipse">
              <Setter Property="Fill" Value="#A7AEBD"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Ok"><Setter Property="Fill" Value="#8FCE7A"/></DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Warn"><Setter Property="Fill" Value="#E0B15A"/></DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Bad"><Setter Property="Fill" Value="#E07A7A"/></DataTrigger>
              </Style.Triggers>
            </Style>
          </Ellipse.Style>
        </Ellipse>
        <TextBlock Text="{Binding Connection}" Foreground="{StaticResource Muted}"/>
      </StackPanel>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
      <Button Content="Sync now" Style="{StaticResource PrimaryButton}" Click="SyncClick" AutomationProperties.Name="Sync now"/>
      <Button Content="Website" Style="{StaticResource QuietButton}" Click="WebClick" AutomationProperties.Name="Open website"/>
      <Button Content="Settings" Style="{StaticResource QuietButton}" Click="SettingsClick" AutomationProperties.Name="Settings"/>
      <Button Content="History" Style="{StaticResource QuietButton}" Click="HistoryClick" AutomationProperties.Name="View synchronization history"/>
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Style="{StaticResource CardBorder}">
          <StackPanel>
            <TextBlock Text="ACCOUNT" Style="{StaticResource Section}"/>
            <TextBlock Text="{Binding Auth}" FontSize="15"/>
            <TextBlock Margin="0,4,0,0" Style="{StaticResource Quiet}" Text="Discord sign-in is not in this build. The legacy guild key stays in Settings."/>
            <TextBlock Margin="0,10,0,0" Style="{StaticResource Quiet}" Text="Guild"/>
            <TextBlock Text="{Binding Guild}" FontSize="15"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource CardBorder}">
          <StackPanel>
            <TextBlock Text="WOW FOREVER" Style="{StaticResource Section}"/>
            <TextBlock Text="{Binding Folder}" TextWrapping="Wrap"/>
            <TextBlock Margin="0,6,0,0" Style="{StaticResource Quiet}" Text="{Binding FolderStatus}"/>
            <TextBlock Margin="0,4,0,0" Style="{StaticResource Quiet}" Text="{Binding SavedStatus}"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource CardBorder}">
          <StackPanel>
            <TextBlock Text="SYNCHRONIZATION" Style="{StaticResource Section}"/>
            <TextBlock Text="{Binding SyncState}" FontSize="16" FontWeight="SemiBold"/>
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Pending" Style="{StaticResource Quiet}"/>
                <TextBlock Text="{Binding Pending}" FontSize="18"/>
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Retry" Style="{StaticResource Quiet}"/>
                <TextBlock Text="{Binding Retry}" FontSize="18"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Failed" Style="{StaticResource Quiet}"/>
                <TextBlock Text="{Binding Failed}" FontSize="18"/>
              </StackPanel>
            </Grid>
            <TextBlock Margin="0,10,0,0" Style="{StaticResource Quiet}" Text="Last upload"/>
            <TextBlock Text="{Binding LastUpload}" TextWrapping="Wrap"/>
            <TextBlock Margin="0,8,0,0" Style="{StaticResource Quiet}" Text="Last error"/>
            <TextBlock Text="{Binding LastError}" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
