<Window x:Class="Ironkeep.Companion.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ironkeep settings"
        Icon="/Assets/logo.png"
        Width="500" Height="880"
        MinWidth="440" MinHeight="560"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
  <Border Background="{StaticResource BgBrush}" Padding="20">
  <DockPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="Retry failed" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="RetryClick" AutomationProperties.Name="Retry failed reports"/>
      <Button Content="Save" Style="{StaticResource AccentButton}" Click="SaveClick" AutomationProperties.Name="Save settings"/>
    </StackPanel>
    <ScrollViewer Style="{StaticResource IronkeepScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock Text="Settings" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="Forever folder, the legacy guild connection, and the queue." Style="{StaticResource PageSubtitle}" Margin="0,2,0,16"/>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="World of Warcraft Forever" Style="{StaticResource CardTitle}"/>
            <TextBlock Text="Choose the installation folder yourself. This build does not assume a Forever layout." Style="{StaticResource CardDesc}"/>
            <TextBlock Text="Installation folder" Style="{StaticResource FieldLabel}"/>
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Browse" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="BrowseClick" AutomationProperties.Name="Browse for WoW folder"/>
              <TextBox x:Name="FolderBox"/>
            </DockPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Connection" Style="{StaticResource CardTitle}"/>
            <TextBlock Text="Discord sign-in is on the main window. The legacy key is a separate fallback and is not used when a Discord session fails." Style="{StaticResource CardDesc}"/>
            <TextBlock x:Name="KeyNote" Style="{StaticResource FieldHint}"/>
            <TextBlock Text="Site address" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="AddressBox"/>
            <TextBlock Text="Guild slug" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="SlugBox"/>
            <TextBlock Text="Legacy key" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="KeyBox"/>
            <TextBlock Style="{StaticResource FieldHint}" Text="Leave the key blank to keep the saved one. It is not shown, and it is not written in the clear."/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <Button Content="Remove saved key" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="ClearKeyClick" AutomationProperties.Name="Remove saved key"/>
              <Button Content="Use legacy key" Style="{StaticResource GhostButton}" Click="UseLegacyClick" AutomationProperties.Name="Use legacy guild key"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Startup" Style="{StaticResource CardTitle}"/>
            <TextBlock Text="The companion keeps syncing from the notification area after the window is closed." Style="{StaticResource CardDesc}"/>
            <CheckBox x:Name="StartupBox" Content="Start with Windows" Margin="0,14,0,0" AutomationProperties.Name="Start with Windows"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0">
          <StackPanel>
            <TextBlock Text="Synchronization history" Style="{StaticResource CardTitle}"/>
            <TextBlock Text="Recent queue items. Report bodies and keys are not listed." Style="{StaticResource CardDesc}"/>
            <TextBlock Text="Last error" Style="{StaticResource FieldLabel}"/>
            <TextBlock x:Name="LastErrorText" TextWrapping="Wrap"/>
            <ListView x:Name="HistoryList" Style="{StaticResource HistoryList}" MaxHeight="220" Margin="0,12,0,0">
              <ListView.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="168"/>
                      <ColumnDefinition Width="118"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding When}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                    <TextBlock Grid.Column="1" Text="{Binding State}" FontWeight="SemiBold" Margin="8,0,8,0"/>
                    <TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="{StaticResource Text2Brush}" FontSize="12.5" TextWrapping="Wrap"/>
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
  </Border>
</Window>
